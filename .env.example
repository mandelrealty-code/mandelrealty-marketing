# Copy to .env.local for local form testing (gitignored)
RESEND_API_KEY=re_your_key_here

# After verifying mandelrealtygroup.com in Resend (SPF/DKIM/DMARC) — required so portal
# invites land in inbox, not spam. Do not leave this on onboarding@resend.dev in production.
# RESEND_FROM=Mandel Realty Group <info@mandelrealtygroup.com>
# RESEND_REPLY_TO=info@mandelrealtygroup.com

# Optional — point the form at a Supabase edge function instead of /api/audit
# VITE_AUDIT_API_URL=https://hyndmdjvjlsbthlqrxge.supabase.co/functions/v1/send-audit-lead

# Meta Pixel (Events Manager → Datasets → Mandel Realty Website)
# Already set in code as default; override here only if you need a different ID
# VITE_META_PIXEL_ID=1583026230149842

# --- Lead inbox (Supabase) ---
# Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Run supabase/leads.sql once in the SQL Editor

# --- Admin (admin.mandelrealtygroup.com only — not /admin on www) ---
ADMIN_PASSWORD=choose-a-strong-password
# Optional; defaults to ADMIN_PASSWORD if unset
# ADMIN_SESSION_SECRET=long-random-string
# Optional dedicated HMAC secrets (recommended — keep separate from ADMIN_PASSWORD)
# OWNER_SESSION_SECRET=long-random-string
# STAFF_SESSION_SECRET=long-random-string

# Optional: manually block call times (comma-separated ISO timestamps)
# BOOKED_CALL_ISOS=2026-07-25T18:00:00.000Z,2026-07-25T18:30:00.000Z

# --- Twilio SMS + Voice (click-to-call) ---
# Console → Account info → Account SID + Auth Token
# Phone Numbers → number must have Voice + SMS enabled
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public marketing origin for owner portal emails (never a Vercel preview URL)
# PUBLIC_SITE_URL=https://mandelrealtygroup.com
# Public URL Twilio hits for voice webhooks (defaults to www.mandelrealtygroup.com)
# PUBLIC_BASE_URL=https://www.mandelrealtygroup.com
# Twilio inbound SMS webhook: https://www.mandelrealtygroup.com/api/twilio/inbound
# Voice (one function): /api/twilio/voice?op=bridge|status|recording|transcription
# After recording: Whisper (OPENAI_API_KEY) → Claude call notes
# Run supabase/crm_calls_v1.sql once (operator_callback_phone + lead_calls)
# Run supabase/crm_call_notes_v1.sql once (leads.call_notes for AI call summaries)

# Secure cron: Vercel → Project → Settings → Environment Variables
# Also used as ?secret= or Authorization: Bearer
CRON_SECRET=long-random-string

# Hobby Vercel only allows 1 cron/day (vercel.json uses daily). For 2h/24h SMS timing,
# either upgrade to Pro, or hit this every 5 min from cron-job.org / EasyCron:
#   GET https://www.mandelrealtygroup.com/api/cron/follow-ups
# Header: Authorization: Bearer <CRON_SECRET>

# Google Calendar → stop SMS when they book (Make/Zapier webhook)
# POST https://www.mandelrealtygroup.com/api/webhooks/booking
# Authorization: Bearer <BOOKING_WEBHOOK_SECRET or CRON_SECRET>
# Body: { "email": "...", "phone": "...", "callStartIso": "...", "title": "MRG Intro Call" }
# BOOKING_WEBHOOK_SECRET=long-random-string

# Meta Lead Ads → Make.com → CRM (no Meta App Review)
# POST https://www.mandelrealtygroup.com/api/webhooks/meta-lead
# Authorization: Bearer <META_LEAD_WEBHOOK_SECRET or CRON_SECRET>
# Full Make steps: docs/MAKE-META-LEADS.md
# META_LEAD_WEBHOOK_SECRET=long-random-string

# Run supabase/lead_followups.sql once in the SQL Editor
# Run supabase/lead_sms_messages.sql once (SMS conversation / replies)
# Run supabase/crm_ai_v1.sql once (pipeline stages, AI toggles, knowledge RAG)
# Run supabase/crm_ai_v2.sql once (nurturing + offer_path)
# Run supabase/crm_inbox_v1.sql once (sms_last_read_at for unread dots)
# Run supabase/crm_notify_v1.sql (or v2 if v1 already applied) for new-lead SMS alerts
# Run supabase/pm_clients_v1.sql once for Clients product mode (hosts, properties, commission)
# Run supabase/staff_portal_v1.sql once for employee / VA team portal (/team/{slug} + time entries)
# Run supabase/staff_portal_v2.sql once (started_at / ended_at on time entries)
# Run supabase/pm_hospitable_v1.sql once (stores Hospitable PAT + unique linked unit ids)
# Run supabase/pm_earnings_contracts_v1.sql once (reservations, expenses, contracts + storage bucket)
# Optional: ADMIN_CRM_URL=https://admin.mandelrealtygroup.com (deep links in notify SMS)
# Twilio inbound webhook (STOP + AI replies): https://www.mandelrealtygroup.com/api/twilio/inbound

# --- AI pre-closer (Claude for SMS; optional OpenAI only for vector search) ---
ANTHROPIC_API_KEY=sk-ant-your-key
# Model for AI SMS (default: claude-haiku-4-5 — cheapest current Claude that stays solid for short SMS)
# ~$1/$5 per MTok vs Sonnet ~$3/$15. Override only if quality dips:
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional — Anthropic has no embeddings API. Without this key, KB still saves and
# Claude retrieves docs via keyword search. With it, RAG uses text-embedding-3-small
# and call recordings are transcribed with Whisper for CRM notes.
# OPENAI_API_KEY=sk-your-key
# Safety kill switch — set to false/off to force-disable AI SMS regardless of CRM Settings
# AI_SMS_ENABLED=true

# --- Clients product mode (Phase 1+) ---
# Optional until Phase 2 sync; Settings shows Connected when set
# HOSPITABLE_PAT=your_hospitable_personal_access_token
# PM_REPORT_TZ=America/Toronto
