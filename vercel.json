{
  "crons": [
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.mandelrealtygroup.com" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "has": [{ "type": "host", "value": "www.mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "has": [{ "type": "host", "value": "mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin?section=session&op=login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin?section=session&op=logout"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin?section=session"
    },
    {
      "source": "/api/admin/leads",
      "destination": "/api/admin?section=leads"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/admin?section=settings"
    },
    {
      "source": "/api/admin/knowledge",
      "destination": "/api/admin?section=knowledge"
    },
    {
      "source": "/api/admin/pm",
      "destination": "/api/admin?section=pm"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "admin.mandelrealtygroup.com" }],
      "destination": "/admin-robots.txt"
    },
    {
      "source": "/((?!api/|robots\\.txt|admin-robots\\.txt|sitemap\\.xml|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
