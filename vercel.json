{
  "crons": [
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.mandelrealtygroup.com" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "has": [{ "type": "host", "value": "www.mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin/",
      "has": [{ "type": "host", "value": "mandelrealtygroup.com" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/revenueaudit",
      "destination": "/revenueaudit/index.html"
    },
    {
      "source": "/revenueaudit/",
      "destination": "/revenueaudit/index.html"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin?section=session&op=login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin?section=session&op=logout"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin?section=session"
    },
    {
      "source": "/api/admin/leads",
      "destination": "/api/admin?section=leads"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/admin?section=settings"
    },
    {
      "source": "/api/admin/knowledge",
      "destination": "/api/admin?section=knowledge"
    },
    {
      "source": "/api/admin/pm",
      "destination": "/api/admin?section=pm"
    },
    {
      "source": "/api/admin/copilot",
      "destination": "/api/admin?section=copilot"
    },
    {
      "source": "/api/webhooks/ops-hub",
      "destination": "/api/admin?section=ops_hub"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "admin.mandelrealtygroup.com" }],
      "destination": "/admin-robots.txt"
    },
    {
      "source": "/((?!api/|revenueaudit(?:/|$)|robots\\.txt|admin-robots\\.txt|sitemap\\.xml|.*\\..*).*)",
      "has": [{ "type": "host", "value": "admin.mandelrealtygroup.com" }],
      "destination": "/index.html"
    },
    { "source": "/thank-you", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/book-a-call", "destination": "/index.html" },
    { "source": "/get-estimate", "destination": "/index.html" },
    { "source": "/muskoka", "destination": "/index.html" },
    { "source": "/makeover", "destination": "/index.html" },
    { "source": "/full-service", "destination": "/index.html" },
    { "source": "/growth", "destination": "/index.html" },
    { "source": "/essentials", "destination": "/index.html" },
    { "source": "/furniture", "destination": "/index.html" },
    { "source": "/owner", "destination": "/index.html" },
    { "source": "/owner/:path*", "destination": "/index.html" },
    { "source": "/team", "destination": "/index.html" },
    { "source": "/team/:path*", "destination": "/index.html" },
    { "source": "/sop", "destination": "/index.html" },
    { "source": "/sop/:path*", "destination": "/index.html" }
  ]
}
